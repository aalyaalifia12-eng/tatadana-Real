# =============================================================================
# TataDana Environment Variables
# All credentials must be loaded via environment variables or Supabase Admin UI
# =============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
WEBHOOK_BASE_URL="https://your-domain.vercel.app"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="tatadana-reports"

# AI Providers (Default keys; can also be managed dynamically from Admin Dashboard)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEFAULT_AI_PROVIDER="gemini" # gemini | openai | deepseek
AI_EXECUTION_MODE="failover" # single | failover

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION="false"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TIMEZONE="Asia/Jakarta"
